{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "sangeetha-maligai-mcp",
      "version": "0.1.0",
      "title": "Sangeetha Maligai"
    },
    "tools": [
      {
        "name": "list_categories",
        "title": "List categories",
        "description": "List all product categories available in the Sangeetha Maligai grocery shop.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_products",
        "title": "List products",
        "description": "List products from the Sangeetha Maligai catalog. Optionally filter by category id or a text query matched against product name and Tamil name.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "category": {
              "description": "Category id (e.g. 'rice-grains', 'dals'). Use list_categories to see valid ids.",
              "type": "string"
            },
            "query": {
              "description": "Text to match against product name / Tamil name.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_shop_info",
        "title": "Get shop info",
        "description": "Return the shop name, tagline, address, phone, WhatsApp number and opening hours.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "build_whatsapp_order",
        "title": "Build WhatsApp order link",
        "description": "Build a pre-filled WhatsApp order message and wa.me link for Sangeetha Maligai from a list of items. Does not send anything — the customer taps the link to send the order themselves.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "items": {
              "minItems": 1,
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "productId": {
                    "type": "string",
                    "description": "Product id from list_products."
                  },
                  "unit": {
                    "type": "string",
                    "description": "One of the product's supported units (e.g. '1 kg', '500 g')."
                  },
                  "qty": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 999
                  }
                },
                "required": [
                  "productId",
                  "unit",
                  "qty"
                ]
              }
            },
            "customerName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "phone": {
              "type": "string",
              "minLength": 5,
              "maxLength": 20,
              "description": "Customer contact phone."
            },
            "address": {
              "type": "string",
              "minLength": 3,
              "maxLength": 400
            }
          },
          "required": [
            "items",
            "customerName",
            "phone",
            "address"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
